  "title": "Robotics club team",
  "statement": "A robotics club has {{J}} juniors and {{S}} seniors. In how many ways can a team of {{j}} juniors and {{s}} seniors be chosen?",
  "difficulty": "easy",
  "tags": { "topics": ["counting/combinations"], "contexts": ["committees-seating"] },
  "answer": {
    "prompt": "Total number of teams",
    "latex": "\\binom{ {{J}} }{ {{j}} }\\cdot\\binom{ {{S}} }{ {{s}} }",
    "common_wrong": [
      {
        "latex": "\\operatorname{P}\\left({{J}},{{j}}\\right)\\cdot\\operatorname{P}\\left({{S}},{{s}}\\right)",
        "feedback": "That counts ordered picks. A team has no order: the same {{j}} juniors picked in a different order is the same team.",
        "mistake_tag": "order-confusion"
      },
      {
        "latex": "\\binom{ {{J}} }{ {{j}} }+\\binom{ {{S}} }{ {{s}} }",
        "feedback": "Adding counts teams of only juniors or only seniors. Every team has both, so each junior group pairs with every senior group.",
        "mistake_tag": "add-vs-multiply"
      },
      {
        "latex": "\\binom{ {{J}}+{{S}} }{ {{j}}+{{s}} }",
        "feedback": "That counts every team of {{j}}+{{s}} people, including ones with the wrong mix of juniors and seniors.",
        "mistake_tag": "overcount"
      }
    ],
    "skeleton": {
      "parts": [
        { "group": { "label": "juniors", "display": "C([a], [b])", "latex": "\\binom{[a]}{[b]}" } },
        { "op": { "display": "×", "latex": "\\times" } },
        { "group": { "label": "seniors", "display": "C([c], [d])", "latex": "\\binom{[c]}{[d]}" } }

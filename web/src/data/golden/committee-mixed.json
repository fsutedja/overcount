  },
  "solution": [
    {
      "kind": "choose",
      "title": "Pick the juniors",
      "latex": "\\binom{ {{J}} }{ {{j}} }",
      "explanation": "Order doesn't matter on a team, so choosing {{j}} of {{J}} juniors is an unordered choice."
    },
    {
      "kind": "choose",
      "title": "Pick the seniors",
      "latex": "\\binom{ {{S}} }{ {{s}} }",
      "explanation": "The same reasoning for the seniors: {{s}} of {{S}}."
    },
    {
      "kind": "combine",
      "title": "Combine the two counts",
      "latex": "\\binom{ {{J}} }{ {{j}} }\\times\\binom{ {{S}} }{ {{s}} }",
      "explanation": "Every team has both juniors and seniors, and the two choices don't affect each other, so multiply (the product rule)."
    }
  ],
